server {
    listen 80;
    server_name localhost;

    # Global Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # Hemos encapsulado correctamente API_HOST dentro del CSP
    # add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${API_HOST} http://localhost:8000 http://localhost:* https://picsum.photos https://fastly.picsum.photos https://*.picsum.photos https://*.unsplash.com https://randomuser.me; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: ${API_HOST} http://localhost:8000 http://localhost:* https://picsum.photos https://fastly.picsum.photos https://*.picsum.photos https://*.unsplash.com https://randomuser.me; frame-ancestors 'none';" always;

    # Gzip Compression for Ultra-Fast Initial Load
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/vnd.ms-fontobject
        application/x-font-ttf
        application/x-web-app-manifest+json
        application/xhtml+xml
        application/xml
        font/opentype
        image/bmp
        image/svg+xml
        image/x-icon
        text/cache-manifest
        text/css
        text/plain
        text/vcard
        text/vnd.rim.location.xloc
        text/vtt
        text/x-component
        text/x-cross-domain-policy;

    # Runtime Environment Config (siempre fresco, sin caché)
    location = /assets/env.js {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires 0 always;
        try_files $uri =404;
    }

    # Static assets caching (Angular fingerprinted bundles)
    location ~* \.(?:ico|css|js|gif|jpe?g|png|svg|woff2?|eot|ttf)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Serve compiled static Angular SPA files (index.html without caching)
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Secure API proxying to FastAPI Backend
    location ^~ /api/ {
        proxy_pass ${API_HOST}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        ${API_KEY_HEADER}
    }

    # PROXY DINÁMICO HACIA AZOR PANEL (Report Types)
    # /azor-proxy/{http|https}/{host}/{puerto}/others/report-types[/{id}]
    # El destino es el dominio ingresado en la acción "Enviar a API": se acepta cualquier IP o dominio.
    # Protecciones: sesión del panel obligatoria (auth_request), ruta fija, solo GET/POST/PATCH
    # y sin reenviar credenciales del usuario. La X-API-Key de integración la inyecta Nginx.
    # Cada destino consultado queda registrado en el access log (va en la URI).
    location ~ ^/azor-proxy/(https?)/([A-Za-z0-9.\-]+|\[[0-9A-Fa-f:.]+\])/([0-9]{1,5})/(others/report-types(?:/[A-Za-z0-9_\-]+)?)$ {
        limit_except GET POST PATCH {
            deny all;
        }

        # Las capturas se guardan antes de que otra expresión regular las sobrescriba
        set $azor_scheme $1;
        set $azor_host $2;
        set $azor_port $3;
        set $azor_path $4;

        auth_request /_azor_proxy_auth;
        error_page 401 403 = @azor_proxy_auth_denied;

        # Necesario para resolver dominios con nombre cuando proxy_pass usa variables
        resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
        resolver_timeout 5s;

        proxy_pass $azor_scheme://$azor_host:$azor_port/$azor_path$is_args$args;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # No reenviar credenciales del usuario del panel hacia el backend externo
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        ${AZOR_PROXY_AUTH_HEADER}

        # HTTPS hacia IPs o dominios con certificados propios
        proxy_ssl_server_name on;
        proxy_ssl_name $azor_host;
        proxy_ssl_verify off;

        # Un dominio equivocado debe fallar rápido (consulta automática del input)
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    # Validación de sesión del panel: los GET /frontend/* del backend core exigen el JWT del usuario
    location = /_azor_proxy_auth {
        internal;
        proxy_method GET;
        proxy_pass ${API_HOST}/frontend/permisos/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization $http_authorization;
        ${API_KEY_HEADER}
    }

    # Sesión inválida: el header permite al frontend distinguirla de un 401 de Azor Panel
    location @azor_proxy_auth_denied {
        default_type application/json;
        add_header X-Azor-Proxy-Auth denied always;
        add_header Access-Control-Expose-Headers X-Azor-Proxy-Auth always;
        return 401 '{"detail":"Sesión inválida o expirada"}';
    }

    # Cualquier otra ruta del proxy queda denegada
    location /azor-proxy/ {
        deny all;
    }

    # SECURE REVERSE PROXY FOR OPENSEARCH
    # 1. Search endpoints (POST only)
    location ~ ^/opensearch/([a-zA-Z0-9_\-]+)/_search$ {
        limit_except POST {
            deny all;
        }
        rewrite ^/opensearch/(.*)$ /$1 break;
        proxy_pass ${OPENSEARCH_HOST};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header WWW-Authenticate;
        ${OPENSEARCH_AUTH_HEADER}
    }

    # 2. Count endpoints (GET only)
    location ~ ^/opensearch/([a-zA-Z0-9_\-]+)/_count$ {
        limit_except GET {
            deny all;
        }
        rewrite ^/opensearch/(.*)$ /$1 break;
        proxy_pass ${OPENSEARCH_HOST};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header WWW-Authenticate;
        ${OPENSEARCH_AUTH_HEADER}
    }

    # 3. Document fetch endpoints (GET only)
    location ~ ^/opensearch/([a-zA-Z0-9_\-]+)/_doc/(.+)$ {
        limit_except GET {
            deny all;
        }
        rewrite ^/opensearch/(.*)$ /$1 break;
        proxy_pass ${OPENSEARCH_HOST};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header WWW-Authenticate;
        ${OPENSEARCH_AUTH_HEADER}
    }

    # 4. Indices cat endpoint (GET only)
    location = /opensearch/_cat/indices {
        limit_except GET {
            deny all;
        }
        rewrite ^/opensearch/(.*)$ /$1 break;
        proxy_pass ${OPENSEARCH_HOST};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header WWW-Authenticate;
        ${OPENSEARCH_AUTH_HEADER}
    }

    # 5. Deny access to any other OpenSearch paths
    location /opensearch/ {
        deny all;
    }

    # PROXY INVERSO PARA WEBSOCKETS (FastAPI)
    location ^~ /ws/ {
        proxy_pass ${API_HOST}/ws/; 
        
        # Habilitar protocolo WebSocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Pasar cabeceras de red importantes
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Para Mantener la conexión abierta sin que Nginx la tumbe por inactividad
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

